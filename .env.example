# Example environment for the west-consumer.
# Copy to .env and fill in real values:  cp .env.example .env

# Selects the config branch in src/settings/*.py.
# "local" talks to a local broker with no auth; anything else uses Confluent Cloud.
RUN_ENVIRONMENT=local

# Which partition this process consumes (0-5). In the container this is set
# automatically by supervisord; only set it for single-process/local runs.
CONSUMER_INSTANCE=0

# --- Globus Search (required in every environment) ---
CLIENT_ID=your-globus-client-id
CLIENT_SECRET=your-globus-client-secret
GLOBUS_SEARCH_INDEX=your-globus-search-index-uuid

# --- Kafka: local ---
# Defaults to broker:29092 when unset, so this is optional for local runs.
# BOOTSTRAP_SERVERS=broker:29092

# --- Kafka: Confluent Cloud (required when RUN_ENVIRONMENT is not "local") ---
# BOOTSTRAP_SERVERS=pkc-xxxxx.region.provider.confluent.cloud:9092
# GROUP_ID=westconsumer
# CONFLUENT_CLOUD_USERNAME=your-api-key
# CONFLUENT_CLOUD_PASSWORD=your-api-secret
# TRANSACTIONS_TOPIC=esgf2.your-environment.transactions
# ERRORS_TOPIC=esgf2.your-environment.errors
# SUCCESS_TOPIC=esgf2.your-environment.success

# --- Optional debugging ---
# Set to any non-empty value to enable verbose librdkafka logging.
# KAFKA_CLIENT_DEBUG=
